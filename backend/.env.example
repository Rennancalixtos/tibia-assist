# URL do projeto Supabase (Project Settings > API > Project URL)
SUPABASE_URL=

# Chave anon do Supabase (Project Settings > API > Project API keys > anon public)
SUPABASE_ANON_KEY=

# Chave service_role do Supabase (Project Settings > API > Project API keys > service_role)
# NUNCA exponha essa chave no frontend, apenas em variaveis de ambiente do servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Chave secreta do Stripe (Developers > API keys > Secret key)
STRIPE_SECRET_KEY=

# Segredo do endpoint de webhook do Stripe (Developers > Webhooks > sua conexao > Signing secret)
STRIPE_WEBHOOK_SECRET=

# ID do preco recorrente criado no Stripe (Product catalog > seu produto > Pricing > price id, comeca com "price_")
STRIPE_PRICE_ID=

# Token do GitHub para checar/baixar releases do repo privado (usado pelo
# auto-update do app desktop). Crie um fine-grained personal access token
# (github.com/settings/personal-access-tokens/new) com acesso SOMENTE a este
# repositorio e permissao "Contents: Read-only".
GITHUB_TOKEN=

# Repositorio no formato "owner/repo" (ex: Rennancalixtos/tibia-assist)
GITHUB_REPO=
