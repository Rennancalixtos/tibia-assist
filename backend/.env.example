# URL do projeto Supabase (Project Settings > API > Project URL)
SUPABASE_URL=

# Chave anon do Supabase (Project Settings > API > Project API keys > anon public)
SUPABASE_ANON_KEY=

# Chave service_role do Supabase (Project Settings > API > Project API keys > service_role)
# NUNCA exponha essa chave no frontend, apenas em variaveis de ambiente do servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Chave secreta do Stripe (Developers > API keys > Secret key)
STRIPE_SECRET_KEY=

# Segredo do endpoint de webhook do Stripe (Developers > Webhooks > sua conexao > Signing secret)
STRIPE_WEBHOOK_SECRET=

# ID do preco recorrente criado no Stripe (Product catalog > seu produto > Pricing > price id, comeca com "price_")
STRIPE_PRICE_ID=

# Token do GitHub para checar/baixar releases do repo privado (usado pelo
# auto-update do app desktop). Crie um fine-grained personal access token
# (github.com/settings/personal-access-tokens/new) com acesso SOMENTE a este
# repositorio e permissao "Contents: Read-only".
GITHUB_TOKEN=

# Repositorio no formato "owner/repo" (ex: Rennancalixtos/tibia-assist)
GITHUB_REPO=

# Bot do Discord (endpoint de Interactions, sem gateway persistente).
# Application ID e Public Key: Discord Developer Portal > sua aplicacao > General Information.
# Bot Token: Discord Developer Portal > sua aplicacao > Bot > Reset Token.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Guild ID usado so pelo script de registro de comandos em desenvolvimento
# (registro por guild e instantaneo; sem isso o registro e global e demora ate 1h).
DISCORD_GUILD_ID=

# Canal onde as solicitacoes de teste gratis sao postadas para aprovacao do admin.
DISCORD_TRIAL_CHANNEL_ID=

# Canais PUBLICOS onde os paineis com os botoes sao publicados (rode
# "npm run discord:post-panel" depois de definir os dois).
DISCORD_TRIAL_PANEL_CHANNEL_ID=
DISCORD_PURCHASE_PANEL_CHANNEL_ID=

# Cargo (role) do Discord autorizado a aprovar/rejeitar solicitacoes de teste
# gratis pelos botoes da mensagem.
DISCORD_ADMIN_ROLE_ID=

# Quantidade padrao de horas concedidas em cada teste gratis aprovado
# (configuravel pelo admin, nunca decidida pelo bot/cliente).
DEFAULT_TRIAL_HOURS=48

# Webhook do canal de atualizacoes do Discord, usado pelo changelog automatico
# a cada merge na main (Discord > Configuracoes do canal > Integracoes > Webhooks).
DISCORD_UPDATES_WEBHOOK_URL=

# Token de acesso do Mercado Pago (Suas integracoes > sua aplicacao > Credenciais de producao > Access Token).
MERCADOPAGO_ACCESS_TOKEN=

# Segredo usado para validar a assinatura do webhook do Mercado Pago
# (Suas integracoes > sua aplicacao > Webhooks > Chave secreta).
MERCADOPAGO_WEBHOOK_SECRET=

# Token estatico exigido no header "x-admin-token" para endpoints admin-only
# (aprovacao de teste, CRUD de planos). Gere um valor aleatorio longo.
ADMIN_API_TOKEN=
